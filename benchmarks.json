{
  "_doc": "Single source of truth for the cross-engine regex benchmark. Edited by hand; consumed by bench_common.py (Python harnesses read it directly) and gen_workloads.py (emits per-engine source for the compiled harnesses into gen/). The `pattern` field is the LOGICAL regex string (the exact bytes the engine's compile() must receive); bench_common applies per-engine transforms: a `(?m)` prefix for non-zeetah engines when `multiline` is set (zeetah uses a struct flag), and `engine_patterns` verbatim overrides. Defaults: kind=corpus, input=corpus, multiline=false, dfa=false, captures=false, skip_engines=[], engine_patterns={}; for corpus workloads spans=grep=true. The `input` field selects the byte source every harness feeds the workload: `corpus` = the mixed deterministic corpus.txt; `logs` = the dense synthetic log file (logs.txt / $LOGCORPUS, every line a `timestamp level message` record) used by the structured-extraction workloads so they hit on every line; `synthetic` = the 'a'-run buffer (the pathological case). `logs`/`corpus` slice at corpus_sizes; `synthetic` uses synthetic_len. See README.md.",

  "corpus_sizes_std": [1024, 8192, 32768, 1048576],
  "corpus_sizes_zeetah": [1024, 8192, 32768, 262144, 1048576],
  "synthetic_len": 50000,

  "engines": ["zeetah", "zeetah-dfa", "mvzr", "re2", "pcre2", "pcre2-jit", "oniguruma", "posix", "stdregex", "ctre", "rust-regex", "fancy-regex", "dotnet-regex", "python-re", "python-regex"],

  "captures_engines": ["zeetah", "zeetah-dfa", "re2", "pcre2", "pcre2-jit", "oniguruma", "stdregex", "rust-regex", "fancy-regex", "dotnet-regex", "python-re", "python-regex"],

  "redux_engines": ["zeetah", "re2", "pcre2", "pcre2-jit", "oniguruma", "stdregex", "rust-regex", "fancy-regex", "dotnet-regex", "python-re", "python-regex"],

  "_gate_exempt_doc": "Engines whose match semantics legitimately differ from the leftmost-first PCRE family (POSIX uses leftmost-LONGEST and treats \\p / \\w as extensions) — measured and shown, but excluded from the cross-engine match-count agreement gate in aggregate.py.",
  "gate_exempt_engines": ["posix"],
  "redux_size": 1048576,
  "redux_members": [
    "Sherlock",
    "[0-9]+",
    "[\\w\\.+-]+@[\\w\\.-]+\\.[\\w\\.-]+",
    "(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)",
    "[0-9]{4}-[0-9]{2}-[0-9]{2}",
    "v?[0-9]+\\.[0-9]+\\.[0-9]+",
    "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
    "\\b(?:break|case|catch|class|const|continue|default|delete|do|else|enum|export|extends|false|finally|for|function|if|import|in|instanceof|new|null|return|super|switch|this|throw|true|try|typeof|var|void|while|with|yield|async|await|let)\\b"
  ],

  "_comptime_doc": "comptime: Pattern(...) compiles via the zeetah comptime path (baked DFA, or comptime tree-backtracker for non-regular + look-assertion patterns). ALL 43 workloads now compile (look-assertions \\b/(?m)/\\Z route to the baked backtracker; deep_alternation bypasses MAX_NFA via the tree-walker; multiline_log uses Options.multiline). Drives the zeetah-comptime harness set; verified by zeetah.compilesAtComptime.",
  "workloads": [
    { "id": "literal",          "pattern": "Sherlock", "dfa": true, "comptime": true },
    { "id": "quantifier",       "pattern": "a+", "dfa": true, "comptime": true },
    { "id": "digits",           "pattern": "[0-9]+", "dfa": true, "comptime": true },
    { "id": "word",             "pattern": "\\w+", "dfa": true, "comptime": true },
    { "id": "alternation",      "pattern": "cat|dog|bird|fish", "dfa": true, "comptime": true },
    { "id": "email",            "pattern": "[\\w\\.+-]+@[\\w\\.-]+\\.[\\w\\.-]+", "skip_engines": ["ctre"], "comptime": true },
    { "id": "uri",              "pattern": "[\\w]+://[^/\\s?#]+[^\\s?#]+(?:\\?[^\\s#]*)?(?:#[^\\s]*)?", "comptime": true },
    { "id": "ipv4",             "pattern": "(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)", "dfa": true, "comptime": true },
    { "id": "html_title",       "pattern": "<h2 class=\"product-title\">(.*?)</h2>", "skip_engines": ["mvzr"], "comptime": true },
    { "id": "href",             "pattern": "href=\"([^\"]+)\"", "captures": true, "comptime": true },
    { "id": "price",            "pattern": "\\$[\\d,]+\\.?\\d*", "skip_engines": ["mvzr"], "comptime": true },
    { "id": "nltk",             "pattern": "(?:[A-Z]\\.)+|\\w+(?:-\\w+)*|\\$?\\d+(?:\\.\\d+)?%?|\\.\\.\\.|[.,;\"'?():_\\-]", "comptime": true },
    { "id": "ssn",              "pattern": "[0-9]{3,3}-[0-9]{2,2}-[0-9]{4,4}", "dfa": true, "skip_engines": ["mvzr"], "comptime": true },
    { "id": "modsec_sqli",      "pattern": "([~!@#$%^&*()\\-+={}\\[\\]|:;\"'´’‘<>\\\\].*?){4,}", "skip_engines": ["ctre"], "comptime": true },
    { "id": "aws_eni",          "pattern": "(?:eni-.*?) ", "skip_engines": ["mvzr"], "comptime": true },
    { "id": "apache_post",      "pattern": "POST (?:/[a-zA-Z0-9_]+){1,}", "dfa": true, "comptime": true },
    { "id": "k8s_fluentd",      "pattern": "(?:\\d{4}-\\d{1,2}-\\d{1,2} \\d{1,2}:\\d{1,2}:\\d{1,2}.\\d{3})\\s+(?:[^\\s]+)\\s+(?:\\d+).*?\\[\\s+(?:.*)\\]\\s+(?:.*)\\s+:\\s+(?:.*)", "skip_engines": ["mvzr"], "comptime": true },
    { "id": "log_parse",        "pattern": "(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3}) (\\w+) (.*)", "input": "logs", "captures": true, "skip_engines": ["mvzr"], "comptime": true },
    { "id": "date_iso",         "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}", "dfa": true, "comptime": true },
    { "id": "date_fields",      "pattern": "([0-9]{4})-([0-9]{2})-([0-9]{2})", "input": "logs", "dfa": true, "captures": true, "comptime": true },
    { "id": "time_hms",         "pattern": "[0-9]{2}:[0-9]{2}:[0-9]{2}", "dfa": true, "comptime": true },
    { "id": "phone_us",         "pattern": "\\(?[0-9]{3}\\)?[ .-][0-9]{3}[ .-][0-9]{4}", "skip_engines": ["ctre"], "comptime": true },
    { "id": "hex_color",        "pattern": "#[0-9a-fA-F]{6}", "dfa": true, "comptime": true },
    { "id": "uuid",             "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", "comptime": true },
    { "id": "mac_addr",         "pattern": "(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}", "comptime": true },
    { "id": "semver",           "pattern": "v?[0-9]+\\.[0-9]+\\.[0-9]+", "dfa": true, "comptime": true },
    { "id": "credit_card",      "pattern": "[0-9]{4}[ -][0-9]{4}[ -][0-9]{4}[ -][0-9]{4}", "skip_engines": ["ctre"], "comptime": true },
    { "id": "log_level",        "pattern": "(?:TRACE|DEBUG|INFO|WARN|ERROR|FATAL)", "dfa": true, "skip_engines": ["mvzr"], "comptime": true },
    { "id": "html_tag",         "pattern": "<[^>]+>", "dfa": true, "comptime": true },
    { "id": "hashtag",          "pattern": "#[A-Za-z0-9_]+", "dfa": true, "comptime": true },
    { "id": "float_sci",        "pattern": "[-+]?[0-9]*\\.?[0-9]+(?:[eE][-+]?[0-9]+)?", "skip_engines": ["ctre"], "comptime": true },
    { "id": "json_string",      "pattern": "\"(?:[^\"\\\\]|\\\\.)*\"", "skip_engines": ["mvzr"], "comptime": true },
    { "id": "base64",           "pattern": "(?:[A-Za-z0-9+/]{4})+={0,2}", "skip_engines": ["mvzr"], "comptime": true },
    { "id": "path_unix",        "pattern": "(?:/[A-Za-z0-9_.-]+)+", "dfa": true, "skip_engines": ["ctre"], "comptime": true },
    { "id": "deep_alternation", "pattern": "\\b(?:break|case|catch|class|const|continue|default|delete|do|else|enum|export|extends|false|finally|for|function|if|import|in|instanceof|new|null|return|super|switch|this|throw|true|try|typeof|var|void|while|with|yield|async|await|let)\\b", "skip_engines": ["mvzr"], "comptime": true },
    { "id": "wildcard_gaps",    "pattern": "foo.*bar.*baz", "skip_engines": ["mvzr"], "comptime": true },
    { "id": "multiline_log",    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}.*$", "multiline": true, "skip_engines": ["mvzr"], "comptime": true,
      "engine_patterns": {
        "stdregex": "^[0-9]{4}-[0-9]{2}-[0-9]{2}.*$",
        "oniguruma": "^[0-9]{4}-[0-9]{2}-[0-9]{2}.*$"
      }
    },
    { "id": "backref_word",     "pattern": "(\\b[A-Za-z]+\\b) \\1", "skip_engines": ["mvzr"], "comptime": true },
    { "id": "lookbehind_amount","pattern": "(?<=\\$)[0-9]+(?:\\.[0-9]{2})?", "skip_engines": ["mvzr"], "comptime": true },
    { "id": "unicode_prop",     "pattern": "[\\p{L}\\p{N}_]+", "skip_engines": ["mvzr", "ctre"], "comptime": true },
    { "id": "atomic_token",     "pattern": "(?>[A-Za-z0-9_]+)@", "skip_engines": ["mvzr"], "comptime": true },
    { "id": "tokenizer",        "pattern": "(?i:[sdmt]|ll|ve|re)|[^\\r\\n\\p{L}\\p{N}]?+\\p{L}+|\\p{N}{1,3}| ?[^\\s\\p{L}\\p{N}]++[\\r\\n]|\\s[\\r\\n]|\\s+(?!\\S)|\\s+",
      "comptime": true,
      "skip_engines": ["mvzr", "ctre"],
      "engine_patterns": {
        "dotnet-regex": "(?i:[sdmt]|ll|ve|re)|(?>[^\\r\\n\\p{L}\\p{N}]?)\\p{L}+|\\p{N}{1,3}| ?(?>[^\\s\\p{L}\\p{N}]+)[\\r\\n]|\\s[\\r\\n]|\\s+(?!\\S)|\\s+"
      }
    },
    { "id": "pathological",     "pattern": "(a+)+b", "kind": "pathological", "input": "synthetic", "dfa": true, "skip_engines": ["posix", "stdregex", "ctre"], "comptime": true },

    { "id": "password_strength","pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).{8,}$", "multiline": true, "skip_engines": ["mvzr", "ctre"], "comptime": true,
      "engine_patterns": {
        "oniguruma": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).{8,}$"
      }
    },
    { "id": "ipv6",             "pattern": "(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}", "dfa": true, "skip_engines": ["mvzr"], "comptime": true },
    { "id": "fqdn",             "pattern": "^(?:[a-z0-9-]+\\.)+[a-z]{2,}$", "multiline": true, "dfa": true, "skip_engines": ["mvzr", "ctre"], "comptime": true },
    { "id": "querystring_kv",   "pattern": "(?<=[?&])([^=&#]+)=([^&#]*)", "captures": true, "skip_engines": ["mvzr", "ctre"], "comptime": true },
    { "id": "csv_field",        "pattern": "(?:\"(?:[^\"]|\"\")*\"|[^,\\n]+)", "skip_engines": ["mvzr"], "comptime": true },
    { "id": "grok_named",       "pattern": "(?<ts>\\d{4}-\\d{2}-\\d{2}) (?<lvl>\\w+) (?<msg>.*)", "dfa": true, "captures": true, "skip_engines": ["mvzr"], "comptime": true,
      "engine_patterns": {
        "python-re": "(?P<ts>\\d{4}-\\d{2}-\\d{2}) (?P<lvl>\\w+) (?P<msg>.*)"
      }
    },
    { "id": "isbn",             "pattern": "^(?:\\d{9}[\\dXx]|\\d{13})$", "multiline": true, "dfa": true, "skip_engines": ["mvzr"], "comptime": true },
    { "id": "postal_uk",        "pattern": "^[A-Za-z]{1,2}\\d{1,2}[A-Za-z]?\\s?\\d[A-Za-z]{2}$", "multiline": true, "dfa": true, "skip_engines": ["mvzr"], "comptime": true },
    { "id": "personnummer_se",  "pattern": "^\\d{6}-[\\dpPtTfF]\\d{3}$", "multiline": true, "dfa": true, "skip_engines": ["mvzr"], "comptime": true },
    { "id": "sqli_nested",      "pattern": "(?i:\\b(?:m(?:s(?:ys(?:ac(?:cess(?:objects|storage|xml)|es)|relationships|queries|objects)|db)|aster\\.\\.sysdatabases|ysql\\.(?:db|user))|pg_(?:catalog|toast)|information_schema|northwind|tempdb)\\b)", "skip_engines": ["mvzr", "ctre"], "comptime": true }
  ]
}
