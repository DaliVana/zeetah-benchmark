{
  "_doc": "Single source of truth for the cross-engine regex benchmark. Edited by hand; consumed by bench_common.py (Python harnesses read it directly) and gen_workloads.py (emits per-engine source for the compiled harnesses into gen/). The `pattern` field is the LOGICAL regex string (the exact bytes the engine's compile() must receive); bench_common applies per-engine transforms: a `(?m)` prefix for non-zeetah engines when `multiline` is set (zeetah uses a struct flag), and `engine_patterns` verbatim overrides. Defaults: kind=corpus, input=corpus, multiline=false, dfa=false, captures=false, skip_engines=[], engine_patterns={}; for corpus workloads spans=grep=true. See README.md.",

  "corpus_sizes_std": [1024, 8192, 32768, 1048576],
  "corpus_sizes_zeetah": [1024, 8192, 32768, 262144, 1048576],
  "synthetic_len": 50000,

  "engines": ["zeetah", "zeetah-dfa", "mvzr", "re2", "pcre2", "pcre2-jit", "posix", "stdregex", "ctre", "rust-regex", "fancy-regex", "dotnet-regex", "python-re", "python-regex"],

  "captures_engines": ["zeetah", "re2", "pcre2", "pcre2-jit", "stdregex", "rust-regex", "fancy-regex", "dotnet-regex", "python-re", "python-regex"],

  "redux_engines": ["zeetah", "re2", "pcre2", "pcre2-jit", "stdregex", "rust-regex", "fancy-regex", "dotnet-regex", "python-re", "python-regex"],

  "_gate_exempt_doc": "Engines whose match semantics legitimately differ from the leftmost-first PCRE family (POSIX uses leftmost-LONGEST and treats \\p / \\w as extensions) — measured and shown, but excluded from the cross-engine match-count agreement gate in aggregate.py.",
  "gate_exempt_engines": ["posix"],
  "redux_size": 1048576,
  "redux_members": [
    "Sherlock",
    "[0-9]+",
    "[\\w\\.+-]+@[\\w\\.-]+\\.[\\w\\.-]+",
    "(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)",
    "[0-9]{4}-[0-9]{2}-[0-9]{2}",
    "v?[0-9]+\\.[0-9]+\\.[0-9]+",
    "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
    "\\b(?:break|case|catch|class|const|continue|default|delete|do|else|enum|export|extends|false|finally|for|function|if|import|in|instanceof|new|null|return|super|switch|this|throw|true|try|typeof|var|void|while|with|yield|async|await|let)\\b"
  ],

  "workloads": [
    { "id": "literal",          "pattern": "Sherlock", "dfa": true },
    { "id": "quantifier",       "pattern": "a+", "dfa": true },
    { "id": "digits",           "pattern": "[0-9]+", "dfa": true },
    { "id": "word",             "pattern": "\\w+", "dfa": true },
    { "id": "alternation",      "pattern": "cat|dog|bird|fish", "dfa": true },
    { "id": "email",            "pattern": "[\\w\\.+-]+@[\\w\\.-]+\\.[\\w\\.-]+", "skip_engines": ["ctre"] },
    { "id": "uri",              "pattern": "[\\w]+://[^/\\s?#]+[^\\s?#]+(?:\\?[^\\s#]*)?(?:#[^\\s]*)?" },
    { "id": "ipv4",             "pattern": "(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)", "dfa": true },
    { "id": "html_title",       "pattern": "<h2 class=\"product-title\">(.*?)</h2>", "skip_engines": ["mvzr"] },
    { "id": "href",             "pattern": "href=\"([^\"]+)\"", "captures": true },
    { "id": "price",            "pattern": "\\$[\\d,]+\\.?\\d*", "skip_engines": ["mvzr"] },
    { "id": "nltk",             "pattern": "(?:[A-Z]\\.)+|\\w+(?:-\\w+)*|\\$?\\d+(?:\\.\\d+)?%?|\\.\\.\\.|[.,;\"'?():_\\-]" },
    { "id": "ssn",              "pattern": "[0-9]{3,3}-[0-9]{2,2}-[0-9]{4,4}", "dfa": true, "skip_engines": ["mvzr"] },
    { "id": "modsec_sqli",      "pattern": "([~!@#$%^&*()\\-+={}\\[\\]|:;\"'´’‘<>\\\\].*?){4,}", "skip_engines": ["ctre"] },
    { "id": "aws_eni",          "pattern": "(?:eni-.*?) ", "skip_engines": ["mvzr"] },
    { "id": "apache_post",      "pattern": "POST (?:/[a-zA-Z0-9_]+){1,}", "dfa": true },
    { "id": "k8s_fluentd",      "pattern": "(?:\\d{4}-\\d{1,2}-\\d{1,2} \\d{1,2}:\\d{1,2}:\\d{1,2}.\\d{3})\\s+(?:[^\\s]+)\\s+(?:\\d+).*?\\[\\s+(?:.*)\\]\\s+(?:.*)\\s+:\\s+(?:.*)", "skip_engines": ["mvzr"] },
    { "id": "date_iso",         "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}", "dfa": true },
    { "id": "time_hms",         "pattern": "[0-9]{2}:[0-9]{2}:[0-9]{2}", "dfa": true },
    { "id": "phone_us",         "pattern": "\\(?[0-9]{3}\\)?[ .-][0-9]{3}[ .-][0-9]{4}", "skip_engines": ["ctre"] },
    { "id": "hex_color",        "pattern": "#[0-9a-fA-F]{6}", "dfa": true },
    { "id": "uuid",             "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}" },
    { "id": "mac_addr",         "pattern": "(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}" },
    { "id": "semver",           "pattern": "v?[0-9]+\\.[0-9]+\\.[0-9]+", "dfa": true },
    { "id": "credit_card",      "pattern": "[0-9]{4}[ -][0-9]{4}[ -][0-9]{4}[ -][0-9]{4}", "skip_engines": ["ctre"] },
    { "id": "log_level",        "pattern": "(?:TRACE|DEBUG|INFO|WARN|ERROR|FATAL)", "dfa": true, "skip_engines": ["mvzr"] },
    { "id": "html_tag",         "pattern": "<[^>]+>", "dfa": true },
    { "id": "hashtag",          "pattern": "#[A-Za-z0-9_]+", "dfa": true },
    { "id": "float_sci",        "pattern": "[-+]?[0-9]*\\.?[0-9]+(?:[eE][-+]?[0-9]+)?", "skip_engines": ["ctre"] },
    { "id": "json_string",      "pattern": "\"(?:[^\"\\\\]|\\\\.)*\"", "skip_engines": ["mvzr"] },
    { "id": "base64",           "pattern": "(?:[A-Za-z0-9+/]{4})+={0,2}", "skip_engines": ["mvzr"] },
    { "id": "path_unix",        "pattern": "(?:/[A-Za-z0-9_.-]+)+", "dfa": true, "skip_engines": ["ctre"] },
    { "id": "deep_alternation", "pattern": "\\b(?:break|case|catch|class|const|continue|default|delete|do|else|enum|export|extends|false|finally|for|function|if|import|in|instanceof|new|null|return|super|switch|this|throw|true|try|typeof|var|void|while|with|yield|async|await|let)\\b", "skip_engines": ["mvzr"] },
    { "id": "wildcard_gaps",    "pattern": "foo.*bar.*baz", "skip_engines": ["mvzr"] },
    { "id": "multiline_log",    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}.*$", "multiline": true, "skip_engines": ["mvzr"],
      "engine_patterns": {
        "stdregex": "^[0-9]{4}-[0-9]{2}-[0-9]{2}.*$"
      }
    },
    { "id": "backref_word",     "pattern": "(\\b[A-Za-z]+\\b) \\1", "skip_engines": ["mvzr"] },
    { "id": "lookbehind_amount","pattern": "(?<=\\$)[0-9]+(?:\\.[0-9]{2})?", "skip_engines": ["mvzr"] },
    { "id": "unicode_prop",     "pattern": "[\\p{L}\\p{N}_]+", "skip_engines": ["mvzr", "ctre"] },
    { "id": "atomic_token",     "pattern": "(?>[A-Za-z0-9_]+)@", "skip_engines": ["mvzr"] },
    { "id": "tokenizer",        "pattern": "(?i:[sdmt]|ll|ve|re)|[^\\r\\n\\p{L}\\p{N}]?+\\p{L}+|\\p{N}{1,3}| ?[^\\s\\p{L}\\p{N}]++[\\r\\n]|\\s[\\r\\n]|\\s+(?!\\S)|\\s+",
      "skip_engines": ["mvzr", "ctre"],
      "engine_patterns": {
        "dotnet-regex": "(?i:[sdmt]|ll|ve|re)|(?>[^\\r\\n\\p{L}\\p{N}]?)\\p{L}+|\\p{N}{1,3}| ?(?>[^\\s\\p{L}\\p{N}]+)[\\r\\n]|\\s[\\r\\n]|\\s+(?!\\S)|\\s+"
      }
    },
    { "id": "pathological",     "pattern": "(a+)+b", "kind": "pathological", "input": "synthetic", "dfa": true, "skip_engines": ["posix", "stdregex", "ctre"] }
  ]
}
